APP_NAME="CDS World"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.cdsworld.org

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# cPanel prefixes names: create database/user in cPanel > MySQL Databases (NEW ones; never reuse another app's)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=websgene_cds
DB_USERNAME=websgene_cdsu
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=cds_session
CACHE_STORE=database
CACHE_PREFIX=cds_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
IMAGE_DRIVER=gd

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@cdsworld.org"
MAIL_FROM_NAME="${APP_NAME}"

# First install only (RolesSeeder). Leave password empty to auto-generate and print once.
SEED_ADMIN_NAME="Site Administrator"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
